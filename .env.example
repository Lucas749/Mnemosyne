# ─── 0G Testnet ───────────────────────────────────────────────────────────────
# Faucet: https://faucet.0g.ai (0.1 A0GI/day)
# Chain: 0G-Galileo-Testnet, ID 16602
ZG_PRIVATE_KEY=0x...
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# ─── ENS / Sepolia ────────────────────────────────────────────────────────────
# Public RPC for reading ENS text records (memory.index, payment.token)
# Any Sepolia JSON-RPC works — e.g. https://1rpc.io/sepolia
SEPOLIA_RPC=https://1rpc.io/sepolia

# Used by packages/identity for ENS text record writes and name registration on Sepolia.
# Must be controller of the ENS name. Same wallet as ZG_PRIVATE_KEY.
ENS_PRIVATE_KEY=0x...

# ─── Uniswap Trading API ──────────────────────────────────────────────────────
# Get your key at https://developers.uniswap.org/dashboard (free tier available)
UNISWAP_API_KEY=your-key-here

# Ethereum mainnet RPC for executing swaps via packages/payments
ETH_RPC_URL=https://eth.llamarpc.com

# ─── API server ───────────────────────────────────────────────────────────────
# Public base URL once hosted (update SKILL.md + mnemosyne-py default)
MNEMOSYNE_API_URL=http://localhost:3000

# Wei amount sent as micro-royalty per query match (default: 0.001 ETH = 1000000000000000)
ROYALTY_WEI=1000000000000000
# Set to true on mainnet to hard-gate content behind confirmed royalty payment (HTTP 402 if deposit fails)
ENFORCE_PAYMENT=false

# ─── Deployed contracts (0G-Galileo-Testnet, chain 16602) ────────────────────
STAKE_VAULT_ADDRESS=
MNEMOSYNE_INFT_ADDRESS=
MNEMOSYNE_REGISTRY_ADDRESS=
VALIDATOR_REGISTRY_ADDRESS=
CHALLENGE_MANAGER_ADDRESS=
ROYALTY_VAULT_ADDRESS=
MNEMOSYNE_MARKET_ADDRESS=
